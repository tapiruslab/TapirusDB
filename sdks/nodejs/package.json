{
  "name": "tapirus",
  "version": "1.0.1",
  "description": "Official Node.js & TypeScript SDK for TapirusDB — Embedded Safe-Rust Quad-Model Database",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "CORE_LICENSE",
    "NOTICE",
    "*.node"
  ],
  "napi": {
    "name": "tapirus",
    "triples": {
      "additional": [
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "aarch64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-node-sdk.js",
    "build:debug": "node ../../scripts/build-node-sdk.js --debug",
    "test": "node test.js",
    "test:package": "node ../../scripts/test-node-package.js",
    "prepack": "node verify-native.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.3"
  },
  "keywords": [
    "tapirus",
    "tapirusdb",
    "embedded",
    "database",
    "sqlite",
    "vector",
    "ai",
    "rag",
    "graph"
  ],
  "author": "TapirusDB Contributors <contact@tapirusdb.com>",
  "license": "MIT AND BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapiruslab/TapirusDB.git"
  }
}
